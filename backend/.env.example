# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:            mongodb://127.0.0.1:27017/cravinggo
# MongoDB Atlas:    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cravinggo
MONGO_URI=mongodb://127.0.0.1:27017/cravinggo

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - the origin your frontend is served from (e.g. Live Server, or a deployed URL)
CLIENT_ORIGIN=http://127.0.0.1:5500

# Stripe (optional - leave blank to run payments in mock/dev mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
